                            className="p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-cyan-400 text-xs flex items-center gap-1"
                          >
                            <Play className="w-3.5 h-3.5" /> Resume
                          </button>
                        )}
                        <button
                          onClick={() => deleteDownloadItem(item.id)}
                          className="p-1.5 rounded-lg bg-white/5 hover:bg-red-500/20 text-red-400 text-xs flex items-center gap-1"
                        >
                          <Trash2 className="w-3.5 h-3.5" /> Delete
                        </button>
                      </div>
                    </div>
                  ))}
              </div>
            </div>
          )}
        </main>

        {/* URL DOWNLOAD MODAL PROMPT */}
        {showDownloaderModal && (
          <div className="absolute inset-0 bg-black/80 backdrop-blur-md z-50 p-4 flex flex-col justify-center items-center">
            <div className="w-full bg-[#0B101B] border border-cyan-500/30 rounded-3xl p-5 space-y-4 shadow-[0_0_50px_rgba(0,240,255,0.2)]">
              <div className="flex justify-between items-center">
                <h3 className="text-base font-bold text-white">Paste Link to Download</h3>
                <button onClick={() => setShowDownloaderModal(false)} className="text-gray-400 hover:text-white">
                  <X className="w-5 h-5" />
                </button>
              </div>
              <p className="text-xs text-gray-400">
                Supports Video links, Magnet links (.torrent), PDFs, Zip files & Images.
              </p>
              <input
                type="text"
                placeholder="https://example.com/video.mp4 or magnet:?"
                value={downloadUrlInput}
                onChange={(e) => setDownloadUrlInput(e.target.value)}
                className="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-cyan-500"
              />
              <button
                onClick={handleInitiateDownload}
                className="w-full py-3 rounded-xl bg-cyan-400 text-black font-bold text-xs shadow-[0_0_15px_rgba(0,240,255,0.4)] hover:bg-cyan-300 transition-all"
              >
                Fetch Media Options
              </button>
            </div>
          </div>
        )}

        {/* RESOLUTION / FORMAT SELECTOR MODAL */}
        {showQualityModal && (
          <div className="absolute inset-0 bg-black/80 backdrop-blur-md z-50 p-4 flex flex-col justify-center items-center">
            <div className="w-full bg-[#0B101B] border border-cyan-500/30 rounded-3xl p-5 space-y-4">
              <div className="flex justify-between items-center">
                <h3 className="text-base font-bold text-white">Select Download Quality</h3>
                <button onClick={() => setShowQualityModal(false)} className="text-gray-400 hover:text-white">
                  <X className="w-5 h-5" />
                </button>
              </div>

              <div className="space-y-2">
                {[
                  { label: "1080p Full HD", sizeMB: 680, format: "MP4 (H.264)" },
                  { label: "720p HD", sizeMB: 340, format: "MP4" },
                  { label: "480p SD", sizeMB: 180, format: "MP4" },
                  { label: "360p Low", sizeMB: 90, format: "MP4" },
                  { label: "Audio Only (MP3)", sizeMB: 12, format: "MP3 320kbps" }
                ].map((opt, i) => (
                  <button
                    key={i}
                    onClick={() => handleConfirmDownload(opt)}
                    className="w-full p-3 bg-white/5 hover:bg-cyan-500/10 border border-white/10 hover:border-cyan-500/40 rounded-xl flex justify-between items-center transition-all"
                  >
                    <div className="text-left">
                      <div className="text-xs font-bold text-white">{opt.label}</div>
                      <div className="text-[10px] text-gray-400">{opt.format}</div>
                    </div>
                    <span className="text-xs font-mono text-cyan-400 font-bold">{opt.sizeMB} MB</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* STICKY 4-TAB BOTTOM NAVIGATION */}
        <nav className="absolute bottom-0 left-0 right-0 h-16 bg-[#0B101B]/95 backdrop-blur-xl border-t border-white/10 flex items-center justify-around z-30 px-2">
          {[
            { id: "videos", label: "Videos", icon: Video },
            { id: "folders", label: "Folders", icon: Folder },
            { id: "audio", label: "Audio", icon: Music },
            { id: "downloads", label: "Downloads", icon: Download }
          ].map((tab) => {
            const Icon = tab.icon;
            const isActive = activeTab === tab.id;
            return (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex flex-col items-center gap-1 transition-all ${
                  isActive ? "text-cyan-400 scale-105" : "text-gray-500 hover:text-gray-300"
                }`}
              >
                <Icon className={`w-5 h-5 ${isActive ? "drop-shadow-[0_0_8px_rgba(0,240,255,0.8)]" : ""}`} />
                <span className="text-[10px] font-medium">{tab.label}</span>
              </button>
            );
          })}
        </nav>
      </div>
    </div>
  );
}
